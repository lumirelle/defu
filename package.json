{
  "name": "@lumirelle/defu",
  "version": "1.2.2",
  "description": "Recursively assign default properties. Lightweight and Fast!",
  "license": "MIT",
  "repository": "lumirelle/defu",
  "files": [
    "dist",
    "lib"
  ],
  "main": "./lib/defu.cjs",
  "module": "./dist/defu.mjs",
  "types": "./dist/defu.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/defu.d.mts",
        "default": "./dist/defu.mjs"
      },
      "require": {
        "types": "./lib/defu.d.cts",
        "default": "./lib/defu.cjs"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "changelogen": "^0.6.2",
    "expect-type": "^1.4.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "pkg-pr-new": "^0.0.87",
    "taze": "^20.0.1",
    "tsdown": "^0.22.14",
    "typescript": "npm:typescript-native-bridge@^6.0.3-bridge.12.tsgo.7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
