{
  "name": "@lumirelle/defu",
  "version": "1.2.0",
  "description": "Recursively assign default properties. Lightweight and Fast!",
  "license": "MIT",
  "repository": "lumirelle/defu",
  "files": [
    "dist",
    "lib"
  ],
  "main": "./lib/defu.cjs",
  "module": "./dist/defu.mjs",
  "types": "./dist/defu.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/defu.d.mts",
        "default": "./dist/defu.mjs"
      },
      "require": {
        "types": "./lib/defu.d.cts",
        "default": "./lib/defu.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vitest",
    "build": "tsdown",
    "lint": "oxlint src && oxfmt --check src test",
    "lint:fix": "oxlint src --fix && oxfmt src test",
    "typecheck": "tsc --noEmit",
    "usagecheck": "echo WIP!",
    "check": "pnpm lint && pnpm typecheck && pnpm usagecheck",
    "test": "pnpm vitest run",
    "prerelease": "pnpm build && pnpm check && pnpm test",
    "release": "changelogen --release && git push --follow-tags"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "changelogen": "^0.6.2",
    "expect-type": "^1.4.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "taze": "^19.17.2",
    "tsdown": "^0.22.14",
    "typescript": "npm:typescript-native-bridge@^6.0.3-bridge.10.tsgo.7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
